# Intello website: environment variables. Copy to .env for local use. Never commit real values.
# On Hostinger set these in hPanel > Web App > Environment variables (names: A-Z, 0-9, _ only).

# production enables strict start-up checks, HSTS and Secure cookies.
NODE_ENV=development
# Listening port. Hostinger may provide it; the app falls back to 3000 only when this is absent.
PORT=3000
# Public base URL used for canonical links, hreflang, the sitemap and Open Graph. No trailing slash.
SITE_URL=http://localhost:3000
# Number of reverse-proxy hops to trust (value confirmed by the hosting spike, S3). 0 locally.
TRUST_PROXY=0

# Outbound mail (Nodemailer over authenticated SMTP). With SMTP_HOST unset and NODE_ENV not
# production, messages are written to the log instead of being sent.
SMTP_HOST=
# 465 (secure from the start) or 587 (STARTTLS).
SMTP_PORT=465
# true for port 465, false for 587.
SMTP_SECURE=true
# Full mailbox address used to log in. SECRET.
SMTP_USER=
# Mailbox password. SECRET.
SMTP_PASS=
# From address of notification emails: a mailbox on the Intello domain the SMTP account may send as.
CONTACT_FROM=
# Who receives enquiries: one or more addresses, comma separated. Treat as private.
CONTACT_TO=
# Random string of at least 32 characters; signs the single-use form token. SECRET.
FORM_TOKEN_SECRET=

# Staging only: set to 1 to let a deploy start while content/site.json still has placeholder details.
ALLOW_PLACEHOLDERS=
# info or debug.
LOG_LEVEL=info
